# Safe template only. Do not put real passwords, tokens, internal IPs, or private hostnames in Git.
# Copy to .env on each installation and use separate per-host values.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=golden_eye
PG_USER=YOUR_DB_USER
PG_PASSWORD=

# Source databases (configure only when enabled)
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
DB60_ZPAY_SERVER=
DB60_ZPAY_PORT=1433
DB60_ZPAY_DATABASE=
DB60_ZPAY_USER=
DB60_ZPAY_PASSWORD=

# Dashboard / Control Center
APP_HOST=127.0.0.1
APP_PORT=8050
CONTROL_CENTER_HOST=127.0.0.1
CONTROL_CENTER_PORT=8060
NAS_IMAGE_FIRST=false
DASHBOARD_READ_MODEL=true
LAZY_PAGE_FIGURES=true
MEDIA_GATEWAY_TOKEN=

# Controlled Golden Eye source and SAP mapping: set on local environment only.
SAP_ESTATE_SCOPE_MAP=
SAP_PRFNR_MAP=
